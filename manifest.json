{
  "manifest_version": 3,
  "name": "PR & Jira Tracker",
  "version": "1.0.0",
  "description": "Track GitHub PRs and Jira tickets across configured repos and projects",
  "action": {
    "default_title": "PR & Jira Tracker"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "sidePanel"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://*.atlassian.net/*"
  ]
}
